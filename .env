# Flask Configuration
SECRET_KEY=fleetflow-super-secret-key-production-change-this
FLASK_ENV=development
PORT=5000

# Email (SMTP) Configuration for Password Reset OTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=FleetFlow Security <noreply@fleetflow.com>
